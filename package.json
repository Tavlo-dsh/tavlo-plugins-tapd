{
  "name": "@tavlo-dsh/dsh-plugin-tapd",
  "version": "0.5.2",
  "description": "将 TAPD 需求和任务单向同步到 Tavlo 任务看板，可按项目指定 DSH 工作区",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tavlo-dsh/tavlo-plugins-tapd.git"
  },
  "homepage": "https://github.com/Tavlo-dsh/tavlo-plugins-tapd#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "icon": "./icon.png",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./icon": "./icon.png",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "runtime.js",
    "settings.js",
    "metadata.js",
    "lib/client.js",
    "lib/client.js.LEGAL.txt",
    "tapd.js",
    "sync.js",
    "icon.png",
    "cordis.patch.yml",
    "tapd.example.patch.yml",
    "licenses/"
  ],
  "engines": {
    "dsh": "0.2.2-rc.1",
    "node": ">=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node --check index.js && node --check runtime.js && node --check settings.js && node --check metadata.js && node --check client.js && node --check tapd.js && node --check sync.js && node scripts/build-client.mjs && node --check lib/client.js",
    "test": "node --test tests/*.test.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.1",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "3.19.0",
    "html-to-text": "9.0.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@emotion/is-prop-valid": "1.4.0",
    "@radix-ui/react-accordion": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "esbuild": "0.28.2",
    "lucide-react": "0.577.0",
    "motion": "12.43.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
